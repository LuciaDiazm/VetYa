// Esquema de la base de datos de VetYa.
// Basado en docs/01-modelo-de-datos.md. Las tablas en MySQL usan snake_case (@@map / @map).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

// DUENIO: dueño de mascota (Mi cuenta). VETERINARIO: atiende (lo clínico). RECEPCION: mostrador
// (clientes, turnos, cobros y avisos, sin lo clínico). ADMIN: administración de la clínica (todo).
enum Rol {
  DUENIO
  VETERINARIO
  ADMIN
  RECEPCION
}

enum Especie {
  PERRO
  GATO
  OTRO
}

enum Sexo {
  MACHO
  HEMBRA
}

enum CategoriaServicio {
  CLINICA
  DIAGNOSTICO
  CIRUGIA
  ESTETICA
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  ATENDIDO
  AUSENTE
  CANCELADO
}

enum OrigenTurno {
  ONLINE
  TELEFONO
  MOSTRADOR
}

enum CanceladoPor {
  DUENIO
  CLINICA
}

enum TipoAplicacion {
  VACUNA
  DESPARASITACION
}

// Cómo pagó el cliente en la clínica (no hay pagos por la web). SIN_CARGO = no se cobró (control, cortesía).
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  SIN_CARGO
}

enum TipoRecordatorio {
  TURNO
  VACUNA
  DESPARASITACION
  RECUPERO
  CARNET
}

// ---------- Clínica y configuración ----------

model Clinica {
  id                  Int       @id @default(autoincrement()) @map("id_clinica")
  nombre              String
  direccion           String
  telefono            String
  whatsapp            String
  email               String?
  instagram           String?
  latitud             Decimal   @db.Decimal(9, 6)
  longitud            Decimal   @db.Decimal(9, 6)
  horasCancelacion    Int       @default(24) @map("horas_cancelacion")
  telefonoUrgencias   String?   @map("telefono_urgencias")
  horarioUrgencias    String?   @map("horario_urgencias") // Ej.: "Todos los días de 8 a 22 h"
  // Regla contra el abuso de turnos web: si un dueño cancela limiteCancelaciones turnos en diasCancelaciones días,
  // queda diasSuspension días sin poder sacar turnos por la web (la clínica decide si lo mantiene).
  limiteCancelaciones Int       @default(3) @map("limite_cancelaciones")
  diasCancelaciones   Int       @default(7) @map("dias_cancelaciones")
  diasSuspension      Int       @default(30) @map("dias_suspension")
  maxTurnosOnline     Int       @default(3) @map("max_turnos_online") // turnos futuros a la vez por la web
  // Desde cuándo se registran los pagos: los turnos atendidos antes no aparecen "Por cobrar".
  pagosDesde          DateTime? @map("pagos_desde")

  usuarios         Usuario[]
  clientes         Cliente[]
  servicios        Servicio[]
  horarios         HorarioAtencion[]
  diasBloqueados   DiaBloqueado[]
  turnos           Turno[]
  preguntas        PreguntaFrecuente[]
  promociones      Promocion[]
  opiniones        Opinion[]
  formasPago       FormaPago[]
  planesSanitarios PlanSanitario[]
  pagos            Pago[]
  presupuestos     Presupuesto[]
  cierresCaja      CierreCaja[]
  archivos         Archivo[]
  auditoria        Auditoria[]

  @@map("clinica")
}

model Usuario {
  id            Int       @id @default(autoincrement()) @map("id_usuario")
  clinicaId     Int       @map("id_clinica")
  nombre        String
  apellido      String
  email         String    @unique
  telefono      String?
  passwordHash  String    @map("password_hash")
  rol           Rol
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  // Las sesiones iniciadas antes de esta fecha ya no valen (se completa al cambiar la contraseña).
  sesionesDesde DateTime? @map("sesiones_desde")

  // Perfil público (sección "Nuestro equipo" de la web)
  visibleEnWeb Boolean @default(false) @map("visible_en_web")
  matricula    String?
  especialidad String?
  presentacion String? @db.Text
  fotoUrl      String? @map("foto_url")

  clinica               Clinica               @relation(fields: [clinicaId], references: [id])
  cliente               Cliente?
  turnosAtendidos       Turno[]               @relation("TurnoVeterinario")
  consultas             Consulta[]
  recordatoriosEnviados Recordatorio[]
  pagosRegistrados      Pago[]                @relation("PagoRegistradoPor")
  pagosAnulados         Pago[]                @relation("PagoAnuladoPor")
  presupuestosHechos    Presupuesto[]         @relation("PresupuestoCreadoPor")
  presupuestosAnulados  Presupuesto[]         @relation("PresupuestoAnuladoPor")
  cierresHechos         CierreCaja[]          @relation("CierreCerradoPor")
  cierresReabiertos     CierreCaja[]          @relation("CierreReabiertoPor")
  consultasEditadas     Consulta[]            @relation("ConsultaEditadaPor")
  aplicacionesCargadas  AplicacionSanitaria[] @relation("AplicacionRegistradaPor")
  aplicacionesAnuladas  AplicacionSanitaria[] @relation("AplicacionAnuladaPor")
  archivosSubidos       Archivo[]
  adjuntosSubidos       Adjunto[]             @relation("AdjuntoSubidoPor")
  adjuntosQuitados      Adjunto[]             @relation("AdjuntoQuitadoPor")
  cambiosHechos         Auditoria[]

  @@map("usuario")
}

model Cliente {
  id        Int      @id @default(autoincrement()) @map("id_cliente")
  clinicaId Int      @map("id_clinica")
  usuarioId Int?     @unique @map("id_usuario")
  nombre    String
  apellido  String
  dni       String?
  telefono  String
  email     String?
  direccion String?
  creadoEn  DateTime @default(now()) @map("creado_en")

  // Suspensión para sacar turnos por la web. "Revisada" = la clínica ya vio el aviso.
  suspendidoHasta    DateTime? @map("suspendido_hasta")
  suspensionMotivo   String?   @map("suspension_motivo")
  suspensionRevisada Boolean   @default(true) @map("suspension_revisada")
  // Turnos web a la vez para este cliente (lo da el administrador). Vacío = el de la clínica.
  maxTurnosOnline    Int?      @map("max_turnos_online")

  clinica       Clinica        @relation(fields: [clinicaId], references: [id])
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id])
  mascotas      Mascota[]
  recordatorios Recordatorio[]
  pagos         Pago[]
  presupuestos  Presupuesto[]

  @@index([clinicaId, telefono])
  @@map("cliente")
}

model Mascota {
  id              Int       @id @default(autoincrement()) @map("id_mascota")
  clienteId       Int       @map("id_cliente")
  nombre          String
  especie         Especie
  // Si la especie es OTRO: qué animal es (conejo, tortuga…), escrito por quien la carga.
  otraEspecie     String?   @map("otra_especie")
  raza            String?
  sexo            Sexo
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  color           String?
  castrado        Boolean   @default(false)
  observaciones   String?   @db.Text
  microchip       String?
  alergias        String?   @db.Text // alergias y condiciones importantes: se muestran en rojo al atender
  fotoId          Int?      @unique @map("id_foto")
  activo          Boolean   @default(true)
  // Enlace privado para ver el carnet de vacunación sin cuenta (se crea la primera vez que se pide).
  tokenCarnet     String?   @unique @map("token_carnet")

  cliente      Cliente               @relation(fields: [clienteId], references: [id])
  foto         Archivo?              @relation("FotoMascota", fields: [fotoId], references: [id], onDelete: SetNull)
  turnos       Turno[]
  consultas    Consulta[]
  aplicaciones AplicacionSanitaria[]
  adjuntos     Adjunto[]
  presupuestos Presupuesto[]

  @@index([microchip])
  @@map("mascota")
}

model Servicio {
  id               Int               @id @default(autoincrement()) @map("id_servicio")
  clinicaId        Int               @map("id_clinica")
  nombre           String
  categoria        CategoriaServicio
  descripcion      String?           @db.Text
  duracionMin      Int               @map("duracion_min")
  precioReferencia Decimal?          @map("precio_referencia") @db.Decimal(10, 2)
  reservableOnline Boolean           @default(true) @map("reservable_online")
  activo           Boolean           @default(true)
  fotoUrl          String?           @map("foto_url")

  clinica      Clinica       @relation(fields: [clinicaId], references: [id])
  turnos       Turno[]
  promociones  Promocion[]
  presupuestos Presupuesto[]

  @@map("servicio")
}

model HorarioAtencion {
  id         Int    @id @default(autoincrement()) @map("id_horario")
  clinicaId  Int    @map("id_clinica")
  diaSemana  Int    @map("dia_semana") // 0 = domingo ... 6 = sábado
  horaInicio String @map("hora_inicio") @db.VarChar(5) // "HH:MM"
  horaFin    String @map("hora_fin") @db.VarChar(5)

  clinica Clinica @relation(fields: [clinicaId], references: [id])

  @@map("horario_atencion")
}

model DiaBloqueado {
  id        Int      @id @default(autoincrement()) @map("id_dia_bloqueado")
  clinicaId Int      @map("id_clinica")
  fecha     DateTime @db.Date
  motivo    String?

  clinica Clinica @relation(fields: [clinicaId], references: [id])

  @@unique([clinicaId, fecha])
  @@map("dia_bloqueado")
}

// ---------- Turnos e historia clínica ----------

model Turno {
  id                    Int           @id @default(autoincrement()) @map("id_turno")
  clinicaId             Int           @map("id_clinica")
  mascotaId             Int           @map("id_mascota")
  servicioId            Int           @map("id_servicio")
  veterinarioId         Int?          @map("id_veterinario")
  fechaHoraInicio       DateTime      @map("fecha_hora_inicio")
  fechaHoraFin          DateTime      @map("fecha_hora_fin")
  estado                EstadoTurno   @default(PENDIENTE)
  origen                OrigenTurno
  observaciones         String?       @db.Text
  recordatorioEnviadoEn DateTime?     @map("recordatorio_enviado_en")
  canceladoEn           DateTime?     @map("cancelado_en")
  canceladoPor          CanceladoPor? @map("cancelado_por")
  llegoEn               DateTime?     @map("llego_en") // Recepción marca "Llegó": queda en la sala de espera
  enConsultaEn          DateTime?     @map("en_consulta_en") // la veterinaria lo hizo pasar (pizarra del día)
  urgente               Boolean       @default(false) // urgencia cargada por el personal: va primero en Hoy
  creadoEn              DateTime      @default(now()) @map("creado_en")

  clinica       Clinica             @relation(fields: [clinicaId], references: [id])
  mascota       Mascota             @relation(fields: [mascotaId], references: [id])
  servicio      Servicio            @relation(fields: [servicioId], references: [id])
  veterinario   Usuario?            @relation("TurnoVeterinario", fields: [veterinarioId], references: [id])
  consulta      Consulta?
  cuestionario  CuestionarioPrevio?
  recordatorios Recordatorio[]
  pagos         Pago[]

  @@index([clinicaId, fechaHoraInicio])
  @@map("turno")
}

// Pago hecho en la clínica. Nunca se borra: si hubo un error se anula (queda quién y por qué).
model Pago {
  id              Int       @id @default(autoincrement()) @map("id_pago")
  clinicaId       Int       @map("id_clinica")
  clienteId       Int?      @map("id_cliente") // vacío = venta en el mostrador a alguien sin ficha
  turnoId         Int?      @map("id_turno") // vacío = cobro sin turno (alimento, medicamento…)
  presupuestoId   Int?      @map("id_presupuesto") // seña o pago a cuenta de un presupuesto
  monto           Decimal   @db.Decimal(10, 2)
  medio           MedioPago
  concepto        String
  nota            String?
  fecha           DateTime  @default(now())
  registradoPorId Int       @map("id_registrado_por")
  anulado         Boolean   @default(false)
  anuladoEn       DateTime? @map("anulado_en")
  anuladoPorId    Int?      @map("id_anulado_por")
  motivoAnulacion String?   @map("motivo_anulacion")

  clinica       Clinica      @relation(fields: [clinicaId], references: [id])
  cliente       Cliente?     @relation(fields: [clienteId], references: [id])
  turno         Turno?       @relation(fields: [turnoId], references: [id])
  presupuesto   Presupuesto? @relation(fields: [presupuestoId], references: [id])
  registradoPor Usuario      @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])
  anuladoPor    Usuario?     @relation("PagoAnuladoPor", fields: [anuladoPorId], references: [id])

  @@index([clinicaId, fecha])
  @@index([clienteId])
  @@index([turnoId])
  @@index([presupuestoId])
  @@map("pago")
}

// Cierre de caja del día: al terminar, quien cobra cuenta el efectivo y lo compara con lo que dice VetYa.
// Con la caja cerrada no se cobra ni se anula nada de ese día. La administración puede reabrirla con motivo
// (el cierre no se borra: queda reabierto, y después se vuelve a cerrar).
model CierreCaja {
  id               Int       @id @default(autoincrement()) @map("id_cierre")
  clinicaId        Int       @map("id_clinica")
  dia              DateTime  @db.Date
  cambioInicial    Decimal   @map("cambio_inicial") @db.Decimal(10, 2) // efectivo que había al abrir (para dar vuelto)
  efectivoCobrado  Decimal   @map("efectivo_cobrado") @db.Decimal(10, 2)
  transferencia    Decimal   @db.Decimal(10, 2)
  debito           Decimal   @db.Decimal(10, 2)
  credito          Decimal   @db.Decimal(10, 2)
  totalCobrado     Decimal   @map("total_cobrado") @db.Decimal(10, 2)
  cantidadCobros   Int       @map("cantidad_cobros")
  efectivoContado  Decimal   @map("efectivo_contado") @db.Decimal(10, 2)
  diferencia       Decimal   @db.Decimal(10, 2) // contado − (cambio + efectivo cobrado): + sobra, − falta
  nota             String?   @db.VarChar(300)
  cerradoEn        DateTime  @default(now()) @map("cerrado_en")
  cerradoPorId     Int       @map("id_cerrado_por")
  reabiertoEn      DateTime? @map("reabierto_en")
  reabiertoPorId   Int?      @map("id_reabierto_por")
  motivoReapertura String?   @map("motivo_reapertura") @db.VarChar(191)

  clinica      Clinica  @relation(fields: [clinicaId], references: [id])
  cerradoPor   Usuario  @relation("CierreCerradoPor", fields: [cerradoPorId], references: [id])
  reabiertoPor Usuario? @relation("CierreReabiertoPor", fields: [reabiertoPorId], references: [id])

  @@index([clinicaId, dia])
  @@map("cierre_caja")
}

enum EstadoPresupuesto {
  VIGENTE
  ANULADO
}

// Presupuesto para una cirugía, una limpieza dental o un tratamiento largo. Se le manda al dueño por WhatsApp;
// si acepta, deja una seña (un pago con id_presupuesto) y el día del turno se cobra lo que falta.
// "Pagado" y "falta" no se guardan: salen de sumar sus pagos no anulados.
model Presupuesto {
  id              Int               @id @default(autoincrement()) @map("id_presupuesto")
  clinicaId       Int               @map("id_clinica")
  clienteId       Int               @map("id_cliente")
  mascotaId       Int?              @map("id_mascota")
  servicioId      Int?              @map("id_servicio") // el turno de este servicio descuenta lo ya pagado
  titulo          String            @db.VarChar(120)
  total           Decimal           @db.Decimal(10, 2)
  validoHasta     DateTime          @map("valido_hasta") @db.Date
  nota            String?           @db.VarChar(500)
  estado          EstadoPresupuesto @default(VIGENTE)
  creadoEn        DateTime          @default(now()) @map("creado_en")
  creadoPorId     Int               @map("id_creado_por")
  anuladoEn       DateTime?         @map("anulado_en")
  anuladoPorId    Int?              @map("id_anulado_por")
  motivoAnulacion String?           @map("motivo_anulacion")

  clinica    Clinica           @relation(fields: [clinicaId], references: [id])
  cliente    Cliente           @relation(fields: [clienteId], references: [id])
  mascota    Mascota?          @relation(fields: [mascotaId], references: [id])
  servicio   Servicio?         @relation(fields: [servicioId], references: [id])
  creadoPor  Usuario           @relation("PresupuestoCreadoPor", fields: [creadoPorId], references: [id])
  anuladoPor Usuario?          @relation("PresupuestoAnuladoPor", fields: [anuladoPorId], references: [id])
  items      PresupuestoItem[]
  pagos      Pago[]

  @@index([clinicaId, creadoEn])
  @@index([clienteId])
  @@index([mascotaId])
  @@map("presupuesto")
}

// Cada renglón del presupuesto (cirugía, anestesia, análisis previos, medicación…).
model PresupuestoItem {
  id            Int     @id @default(autoincrement()) @map("id_item")
  presupuestoId Int     @map("id_presupuesto")
  descripcion   String  @db.VarChar(160)
  monto         Decimal @db.Decimal(10, 2)
  orden         Int

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@index([presupuestoId])
  @@map("presupuesto_item")
}

model Consulta {
  id            Int       @id @default(autoincrement()) @map("id_consulta")
  mascotaId     Int       @map("id_mascota")
  veterinarioId Int       @map("id_veterinario")
  turnoId       Int?      @unique @map("id_turno")
  fecha         DateTime  @default(now())
  motivo        String
  pesoKg        Decimal?  @map("peso_kg") @db.Decimal(5, 2)
  temperatura   Decimal?  @db.Decimal(4, 1)
  diagnostico   String?   @db.Text
  tratamiento   String?   @db.Text
  observaciones String?   @db.Text
  editadaEn     DateTime? @map("editada_en") // la versión anterior queda en auditoria
  editadaPorId  Int?      @map("id_editada_por")

  mascota      Mascota               @relation(fields: [mascotaId], references: [id])
  veterinario  Usuario               @relation(fields: [veterinarioId], references: [id])
  editadaPor   Usuario?              @relation("ConsultaEditadaPor", fields: [editadaPorId], references: [id])
  turno        Turno?                @relation(fields: [turnoId], references: [id])
  aplicaciones AplicacionSanitaria[]
  adjuntos     Adjunto[]

  @@map("consulta")
}

model AplicacionSanitaria {
  id                Int            @id @default(autoincrement()) @map("id_aplicacion")
  mascotaId         Int            @map("id_mascota")
  consultaId        Int?           @map("id_consulta")
  tipo              TipoAplicacion
  producto          String
  lote              String?
  fechaAplicacion   DateTime       @map("fecha_aplicacion") @db.Date
  fechaProximaDosis DateTime?      @map("fecha_proxima_dosis") @db.Date
  registradoPorId   Int?           @map("id_registrado_por")
  creadoEn          DateTime       @default(now()) @map("creado_en")
  // No se borran: si se cargó mal, se anula con el motivo (deja de avisar y de salir en el carnet).
  anulada           Boolean        @default(false)
  anuladaEn         DateTime?      @map("anulada_en")
  anuladaPorId      Int?           @map("id_anulada_por")
  motivoAnulacion   String?        @map("motivo_anulacion")

  mascota       Mascota        @relation(fields: [mascotaId], references: [id])
  consulta      Consulta?      @relation(fields: [consultaId], references: [id])
  registradoPor Usuario?       @relation("AplicacionRegistradaPor", fields: [registradoPorId], references: [id])
  anuladaPor    Usuario?       @relation("AplicacionAnuladaPor", fields: [anuladaPorId], references: [id])
  recordatorios Recordatorio[]

  @@index([fechaProximaDosis])
  @@map("aplicacion_sanitaria")
}

model Recordatorio {
  id           Int              @id @default(autoincrement()) @map("id_recordatorio")
  clienteId    Int              @map("id_cliente")
  usuarioId    Int              @map("id_usuario")
  tipo         TipoRecordatorio
  turnoId      Int?             @map("id_turno")
  aplicacionId Int?             @map("id_aplicacion")
  mensaje      String           @db.Text
  enviadoEn    DateTime         @default(now()) @map("enviado_en")

  cliente    Cliente              @relation(fields: [clienteId], references: [id])
  usuario    Usuario              @relation(fields: [usuarioId], references: [id])
  turno      Turno?               @relation(fields: [turnoId], references: [id])
  aplicacion AplicacionSanitaria? @relation(fields: [aplicacionId], references: [id])

  @@map("recordatorio")
}

// ---------- Contenido público ----------

model PreguntaFrecuente {
  id        Int    @id @default(autoincrement()) @map("id_pregunta")
  clinicaId Int    @map("id_clinica")
  pregunta  String
  respuesta String @db.Text
  orden     Int    @default(0)

  clinica Clinica @relation(fields: [clinicaId], references: [id])

  @@map("pregunta_frecuente")
}

// Opcional: se implementa al final si hay tiempo.
model Promocion {
  id                   Int      @id @default(autoincrement()) @map("id_promocion")
  clinicaId            Int      @map("id_clinica")
  servicioId           Int?     @map("id_servicio")
  titulo               String
  descripcion          String   @db.Text
  porcentajeDescuento  Int?     @map("porcentaje_descuento")
  soloPrimeraAtencion  Boolean  @default(false) @map("solo_primera_atencion")
  requiereVacunasAlDia Boolean  @default(false) @map("requiere_vacunas_al_dia")
  vigenteDesde         DateTime @map("vigente_desde") @db.Date
  vigenteHasta         DateTime @map("vigente_hasta") @db.Date

  clinica  Clinica   @relation(fields: [clinicaId], references: [id])
  servicio Servicio? @relation(fields: [servicioId], references: [id])

  @@map("promocion")
}

// ---------- Funciones del sitio público (segunda etapa) ----------

// Opiniones de clientes que el administrador publica en la web.
model Opinion {
  id        Int      @id @default(autoincrement()) @map("id_opinion")
  clinicaId Int      @map("id_clinica")
  autor     String
  mascota   String?
  texto     String   @db.Text
  puntaje   Int // 1 a 5
  fecha     DateTime @db.Date
  visible   Boolean  @default(true)

  clinica Clinica @relation(fields: [clinicaId], references: [id])

  @@map("opinion")
}

// Formas de pago que acepta la clínica (efectivo, transferencia, Mercado Pago...).
model FormaPago {
  id        Int     @id @default(autoincrement()) @map("id_forma_pago")
  clinicaId Int     @map("id_clinica")
  nombre    String
  detalle   String?
  orden     Int     @default(0)

  clinica Clinica @relation(fields: [clinicaId], references: [id])

  @@map("forma_pago")
}

// Calendario sanitario recomendado según la edad (ej. "Plan cachorro").
model PlanSanitario {
  id          Int     @id @default(autoincrement()) @map("id_plan")
  clinicaId   Int     @map("id_clinica")
  nombre      String
  especie     Especie
  descripcion String  @db.Text
  fotoUrl     String? @map("foto_url")
  activo      Boolean @default(true)

  clinica Clinica              @relation(fields: [clinicaId], references: [id])
  dosis   PlanSanitarioDosis[]

  @@map("plan_sanitario")
}

// Cada aplicación del plan, con la edad recomendada.
model PlanSanitarioDosis {
  id          Int            @id @default(autoincrement()) @map("id_dosis")
  planId      Int            @map("id_plan")
  tipo        TipoAplicacion
  producto    String
  edadSemanas Int            @map("edad_semanas")
  nota        String?

  plan PlanSanitario @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_sanitario_dosis")
}

// Lo completa el dueño al sacar turno; el veterinario lo lee antes de atender.
model CuestionarioPrevio {
  id               Int      @id @default(autoincrement()) @map("id_cuestionario")
  turnoId          Int      @unique @map("id_turno")
  sintomas         String?  @db.Text
  desdeCuando      String?  @map("desde_cuando")
  comeYBebeNormal  Boolean? @map("come_y_bebe_normal")
  vomitosODiarrea  Boolean? @map("vomitos_o_diarrea")
  alimentacion     String?  @db.Text
  medicacionActual String?  @map("medicacion_actual") @db.Text
  observaciones    String?  @db.Text
  completadoEn     DateTime @default(now()) @map("completado_en")

  turno Turno @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@map("cuestionario_previo")
}

// Archivos que sube la clínica (fotos de mascotas y del equipo, análisis, ecografías…).
// Se guardan dentro de la base: así no se pierden si el servidor se reinicia (Render borra los archivos sueltos)
// y entran en las copias de seguridad de la base.
model Archivo {
  id          Int      @id @default(autoincrement()) @map("id_archivo")
  clinicaId   Int      @map("id_clinica")
  nombre      String // nombre original, para descargarlo con el mismo nombre
  tipo        String // image/jpeg, application/pdf…
  tamanio     Int
  datos       Bytes    @db.MediumBlob // hasta 16 MB (la app permite 8 MB)
  publico     Boolean  @default(false) // true = foto del equipo para la web
  subidoPorId Int?     @map("id_subido_por")
  creadoEn    DateTime @default(now()) @map("creado_en")

  clinica   Clinica  @relation(fields: [clinicaId], references: [id])
  subidoPor Usuario? @relation(fields: [subidoPorId], references: [id])
  fotoDe    Mascota? @relation("FotoMascota")
  adjunto   Adjunto?

  @@map("archivo")
}

// Archivo adjunto a la historia clínica (un análisis, una ecografía, una radiografía).
// No se borra: si se subió por error, se quita (deja de verse) y queda quién y cuándo.
model Adjunto {
  id           Int       @id @default(autoincrement()) @map("id_adjunto")
  mascotaId    Int       @map("id_mascota")
  consultaId   Int?      @map("id_consulta")
  archivoId    Int       @unique @map("id_archivo")
  descripcion  String?
  subidoPorId  Int       @map("id_subido_por")
  creadoEn     DateTime  @default(now()) @map("creado_en")
  quitado      Boolean   @default(false)
  quitadoEn    DateTime? @map("quitado_en")
  quitadoPorId Int?      @map("id_quitado_por")

  mascota    Mascota   @relation(fields: [mascotaId], references: [id])
  consulta   Consulta? @relation(fields: [consultaId], references: [id])
  archivo    Archivo   @relation(fields: [archivoId], references: [id])
  subidoPor  Usuario   @relation("AdjuntoSubidoPor", fields: [subidoPorId], references: [id])
  quitadoPor Usuario?  @relation("AdjuntoQuitadoPor", fields: [quitadoPorId], references: [id])

  @@index([mascotaId])
  @@map("adjunto")
}

// Registro de cambios: quién cambió qué y cuándo (consultas corregidas, vacunas anuladas, turnos movidos,
// pagos, personal). Solo se agregan filas: nunca se editan ni se borran.
model Auditoria {
  id        Int      @id @default(autoincrement()) @map("id_auditoria")
  clinicaId Int      @map("id_clinica")
  usuarioId Int?     @map("id_usuario")
  fecha     DateTime @default(now())
  accion    String // ej.: consulta.corregir, vacuna.anular, turno.mover
  entidad   String // consulta, aplicacion, turno, pago, usuario, mascota, adjunto
  entidadId Int      @map("id_entidad")
  resumen   String   @db.Text // en palabras: "Corrigió la consulta de Firulais"
  antes     Json?
  despues   Json?

  clinica Clinica  @relation(fields: [clinicaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([clinicaId, fecha])
  @@index([entidad, entidadId])
  @@map("auditoria")
}
